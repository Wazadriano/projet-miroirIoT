# Smart Mirror - local environment configuration
# Copy this file to .env (same directory) and fill in the real values.
# .env is gitignored and MUST NOT be committed.
#
# Generate a token on the CRM (Laravel Sanctum) and put it here.

CRM_BASE_URL=https://api-kbeauty.a3n.fr/api
CRM_TOKEN=replace-with-rotated-crm-token

# PostgreSQL (lu par docker-compose.yml et par le service local mock-api).
# OBLIGATOIRE, sans valeur par defaut : docker compose et le service refusent de
# demarrer si la variable est vide. Generation d'une valeur forte :
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Adresse de publication des ports Docker (PostgreSQL 5432, API 8100, IA 3001,
# Adminer 8080). Boucle locale par defaut ; 0.0.0.0 pour rendre les services
# accessibles a une VM ou au reseau local.
BIND_ADDRESS=127.0.0.1

# Services lances hors Docker (node src/server.js, node proxy.js) : ils ecoutent
# sur 127.0.0.1 par defaut. A elargir seulement si un autre hote doit y acceder.
# MOCK_API_HOST=0.0.0.0
# MOCK_IA_HOST=0.0.0.0
# LISTEN_HOST=0.0.0.0

# Cle maitre de chiffrement applicatif (AES-256-GCM, 32 octets en base64) utilisee
# par le device. En production sur le Pi : fournir via systemd-creds (recommande)
# ou MASTER_KEY_FILE plutot que par cette variable. Generation :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SMART_MIRROR_MASTER_KEY=
